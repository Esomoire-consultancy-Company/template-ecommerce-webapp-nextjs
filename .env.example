BUNDLE_ANALYZE=false
ENVIRONMENT_NAME=local

# The URL for the domain your app is hosted on (used for generating the urls needed for SEO)
# If you deploy to Vercel or Netlify it is configured through the respective config files (`vercel.json` and `netlify.toml`)
NEXT_PUBLIC_BASE_URL=http://localhost:3000/

# Your current space ID: https://www.contentful.com/help/find-space-id/
CONTENTFUL_SPACE_ID=

# Your current space Content Delivery API access token: https://www.contentful.com/developers/docs/references/content-delivery-api/
CONTENTFUL_ACCESS_TOKEN=

# Your current space Content Preview API access token: https://www.contentful.com/developers/docs/references/content-preview-api/
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# A unique string used to identify preview requests: https://nextjs.org/docs/advanced-features/preview-mode#securely-accessing-it-from-your-headless-cms
CONTENTFUL_PREVIEW_SECRET=

# Governed external bank connection (R0.1)
# Provider identifiers and public callback configuration may be committed as names only.
# NEVER commit bank usernames/passwords, OTPs, access tokens, refresh tokens, client secrets,
# full account numbers, or signing keys. Supply secrets through the deployment secret store.
BANK_CONNECTION_PROVIDER=disabled
BANK_CONNECTION_CALLBACK_URL=
BANK_CONNECTION_CLIENT_ID=
BANK_CONNECTION_CLIENT_SECRET=
BANK_CONNECTION_WEBHOOK_SECRET=

# BANK-CONNECTION-001 R0.3 — Setu AA sandbox binding
# Use only non-secret provider/environment identifiers in source.
# Supply all secret values through the runtime/deployment secret store.
SETU_AA_ENVIRONMENT=sandbox
SETU_AA_PRODUCT_INSTANCE_ID=
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_ACCESS_TOKEN=
SETU_AA_NOTIFICATION_URL=
SETU_AA_NOTIFICATION_VERIFICATION_SECRET=

# BANK-CONNECTION-001 R0.4 sandbox execution inputs
# Synthetic/test VUA only. Do not place production customer identifiers here.
SETU_AA_TEST_VUA=
WARDEN_DECISION_REF=

# BANK-CONNECTION-001 R0.5/R0.6 sandbox lifecycle
SETU_AA_ACTION=
SETU_AA_CONSENT_ID=
SETU_AA_SESSION_ID=
SETU_AA_DATA_FROM=
SETU_AA_DATA_TO=
SETU_AA_FI_READY_STATUS=
SETU_AA_NOTIFICATION_CORRELATION_REF=

# BANK-CONNECTION-001 R0.7 resumable local evidence run
BANK_RUN_ID=
BANK_ACTOR_REF=
BANK_MERCHANT_REF=
BANK_CONNECTION_REF=
SETU_AA_EVIDENCE_ACTION=
BANK_EXPECTATION_REF=
BANK_EXPECTED_AMOUNT_MINOR=
BANK_EXPECTED_CURRENCY=INR
BANK_EXPECTED_DIRECTION=
BANK_EXPECTED_PROVIDER_REFERENCE=
BANK_EXPECTED_TOLERANCE_MINOR=0
BANK_PROVIDER_TRANSACTION_REF=

# BANK-CONNECTION-001 R0.8 River event compilation
# These are canonical River routing/context references, not bank credentials.
RIVER_WORKSPACE_ID=
RIVER_STREAM_ID=
RIVER_DIGITALME_PRINCIPAL=
RIVER_ORGANISATION_ID=
RIVER_WORKFLOW_ID=
RIVER_CORRELATION_ID=
RIVER_CAUSATION_ID=
